# Screen profile: XF-GF110648, 240x240 logical frame, GC9A01 controller, MCU 8-bit / I80 bus.
# CONFIG_EXAMPLE_LCD_CONTROLLER_ST7789 is not set
# CONFIG_EXAMPLE_LCD_CONTROLLER_ST7735 is not set
# CONFIG_EXAMPLE_LCD_CONTROLLER_GC9D01N is not set
CONFIG_EXAMPLE_LCD_CONTROLLER_GC9A01=y

# CONFIG_EXAMPLE_LCD_BUS_SPI is not set
CONFIG_EXAMPLE_LCD_BUS_I80=y

CONFIG_EXAMPLE_LCD_H_RES=240
CONFIG_EXAMPLE_LCD_V_RES=240
CONFIG_EXAMPLE_LCD_X_GAP=0
CONFIG_EXAMPLE_LCD_Y_GAP=0
CONFIG_EXAMPLE_LCD_INVERT_COLOR=y
# CONFIG_EXAMPLE_LCD_RGB_ORDER_RGB is not set
CONFIG_EXAMPLE_LCD_RGB_ORDER_BGR=y
CONFIG_EXAMPLE_LCD_MIRROR_X=y
# CONFIG_EXAMPLE_LCD_MIRROR_Y is not set
# CONFIG_EXAMPLE_LCD_SWAP_XY is not set

CONFIG_EXAMPLE_LCD_PIXEL_CLOCK_HZ=10000000
CONFIG_EXAMPLE_PIN_NUM_LCD_DC=9
CONFIG_EXAMPLE_PIN_NUM_LCD_CS=10
CONFIG_EXAMPLE_PIN_NUM_LCD_RST=14
CONFIG_EXAMPLE_PIN_NUM_LCD_WR=12
CONFIG_EXAMPLE_PIN_NUM_DATA0=4
CONFIG_EXAMPLE_PIN_NUM_DATA1=5
CONFIG_EXAMPLE_PIN_NUM_DATA2=6
CONFIG_EXAMPLE_PIN_NUM_DATA3=7
CONFIG_EXAMPLE_PIN_NUM_DATA4=15
CONFIG_EXAMPLE_PIN_NUM_DATA5=16
CONFIG_EXAMPLE_PIN_NUM_DATA6=17
CONFIG_EXAMPLE_PIN_NUM_DATA7=18
CONFIG_EXAMPLE_PIN_NUM_BK_LIGHT=-1
