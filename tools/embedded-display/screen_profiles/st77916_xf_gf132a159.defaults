# Screen profile: XF-GF132A159, 360x360 logical frame, ST77916 controller, QSPI bus.
# CONFIG_EXAMPLE_LCD_CONTROLLER_ST7789 is not set
# CONFIG_EXAMPLE_LCD_CONTROLLER_ST7735 is not set
# CONFIG_EXAMPLE_LCD_CONTROLLER_GC9D01N is not set
# CONFIG_EXAMPLE_LCD_CONTROLLER_GC9A01 is not set
CONFIG_EXAMPLE_LCD_CONTROLLER_ST77916=y

# CONFIG_EXAMPLE_LCD_BUS_SPI is not set
CONFIG_EXAMPLE_LCD_BUS_QSPI=y
# CONFIG_EXAMPLE_LCD_BUS_I80 is not set

CONFIG_EXAMPLE_LCD_H_RES=360
CONFIG_EXAMPLE_LCD_V_RES=360
CONFIG_EXAMPLE_LCD_X_GAP=0
CONFIG_EXAMPLE_LCD_Y_GAP=0
CONFIG_EXAMPLE_LCD_INVERT_COLOR=y
CONFIG_EXAMPLE_LCD_RGB_ORDER_RGB=y
# CONFIG_EXAMPLE_LCD_RGB_ORDER_BGR is not set
# CONFIG_EXAMPLE_LCD_MIRROR_X is not set
# CONFIG_EXAMPLE_LCD_MIRROR_Y is not set
# CONFIG_EXAMPLE_LCD_SWAP_XY is not set

CONFIG_EXAMPLE_LCD_PIXEL_CLOCK_HZ=40000000
CONFIG_EXAMPLE_PIN_NUM_SCLK=12
CONFIG_EXAMPLE_PIN_NUM_MOSI=11
CONFIG_EXAMPLE_PIN_NUM_MISO=13
CONFIG_EXAMPLE_PIN_NUM_SPI_DATA2=15
CONFIG_EXAMPLE_PIN_NUM_SPI_DATA3=16
CONFIG_EXAMPLE_PIN_NUM_LCD_DC=-1
CONFIG_EXAMPLE_PIN_NUM_LCD_CS=10
CONFIG_EXAMPLE_PIN_NUM_LCD_RST=14
CONFIG_EXAMPLE_PIN_NUM_BK_LIGHT=-1
